# ==========================================================
#  Django — основные настройки (ШАБЛОН, скопируйте в .env)
# ==========================================================
DJANGO_SECRET_KEY=change-me-generate-a-new-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# Домен и URL
DOMAIN_NAME=your-domain.example
SITE_URL=https://your-domain.example

# ==========================================================
#  База данных (SQLite по умолчанию)
# ==========================================================
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# --- PostgreSQL (для режима прода) -------------------------------------
# 1) Раскомментируйте блок ниже.
# 2) Запустите деплой с профилем postgres:  make deploy POSTGRES=1
#    (в docker-compose хост базы всегда «db», DB_HOST задаётся автоматически).
# 3) Если PostgreSQL внешний (не из этого compose) — укажите реальный DB_HOST.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=lms_db
# DB_USER=lms_user
# DB_PASSWORD=change-me-strong-password
# DB_HOST=db
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10

# ==========================================================
#  Email (для будущего подтверждения регистрации)
# ==========================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# ==========================================================
#  Caddy
# ==========================================================
CADDY_EMAIL=admin@your-domain.example

# ==========================================================
#  Gunicorn
# ==========================================================
GUNICORN_WORKERS=3
GUNICORN_BIND=0.0.0.0:8000

# ==========================================================
#  Docker
# ==========================================================
COMPOSE_PROJECT_NAME=lms_ege_oge
