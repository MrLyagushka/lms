# ==========================================================
#  Django — основные настройки (ШАБЛОН, скопируйте в .env)
# ==========================================================
DJANGO_SECRET_KEY=change-me-generate-a-new-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.example,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example,http://localhost

# Домен и URL
DOMAIN_NAME=your-domain.example
SITE_URL=https://your-domain.example

# ==========================================================
#  База данных (SQLite по умолчанию)
# ==========================================================
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
# Для PostgreSQL раскомментируй блок ниже:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=lms_db
# DB_USER=lms_user
# DB_PASSWORD=lms_password
# DB_HOST=db
# DB_PORT=5432

# ==========================================================
#  Email (для будущего подтверждения регистрации)
# ==========================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# ==========================================================
#  Caddy
# ==========================================================
CADDY_EMAIL=admin@your-domain.example

# ==========================================================
#  Gunicorn
# ==========================================================
GUNICORN_WORKERS=3
GUNICORN_BIND=0.0.0.0:8000

# ==========================================================
#  Docker
# ==========================================================
COMPOSE_PROJECT_NAME=lms_ege_oge
