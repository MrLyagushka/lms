study.lyagushkas.ru {
    encode gzip

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    tls {$CADDY_EMAIL}

    # Статика Django (собранная collectstatic в общий том)
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    # FIX: Django проверяет доступ к каждому пользовательскому файлу.
    handle /media/* {
        reverse_proxy web:8000
    }

    handle {
        reverse_proxy web:8000
    }

    log {
        output stdout
    }
}

http://localhost {
    handle_path /static/* {
        root * /srv/static
        file_server
    }

    handle /media/* {
        reverse_proxy web:8000
    }

    handle {
        reverse_proxy web:8000
    }
}
